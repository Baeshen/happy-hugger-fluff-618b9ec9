# نسخة من هذا الملف إلى .env.local (لا تُرفع إلى Git)
# ثم حمّلها: set -a; source .env.local; set +a

# عنوان مشروع Supabase (يبدأ بـ https:// وينتهي بـ .supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# مفتاح العميل (anon/public key) — يُستخدم لمحاكاة المستخدمين المجهولين/المسجّلين
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# مفتاح الخدمة — يُستخدم لتهيئة البيانات وتنظيفها بعد الاختبارات
# تنبيه: هذا المفتاح غير متاح على Lovable Cloud.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
